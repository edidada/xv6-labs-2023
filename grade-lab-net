#!/usr/bin/env python3

import re
import subprocess
import os
import signal
import time
from pathlib import Path
from gradelib import *

r = Runner(save("xv6.out"))

@test(0, "running nettests")
def test_nettest():
    Path('.ci-results').mkdir(exist_ok=True)
    log = Path('.ci-results/server.log')
    with log.open('w') as output:
        server = subprocess.Popen(["make", "server"], stdout=output, stderr=output,
                                  start_new_session=True)
        try:
            deadline = time.monotonic() + 10
            while 'listening on' not in log.read_text():
                if server.poll() is not None or time.monotonic() > deadline:
                    raise AssertionError('UDP server failed to become ready: ' + log.read_text())
                time.sleep(0.05)
            r.run_qemu(shell_script(['nettests']), timeout=30)
        finally:
            if server.poll() is None:
                os.killpg(server.pid, signal.SIGTERM)
            server.wait(timeout=10)

@test(40, "nettest: ping", parent=test_nettest)
def test_nettest_():
    r.match('^testing ping: OK$')

@test(20, "nettest: single process", parent=test_nettest)
def test_nettest_():
    r.match('^testing single-process pings: OK$')

@test(20, "nettest: multi-process", parent=test_nettest)
def test_nettest_fork_test():
    r.match('^testing multi-process pings: OK$')

@test(19, "nettest: DNS", parent=test_nettest)
def test_nettest_dns_test():
    r.match('^DNS OK$')


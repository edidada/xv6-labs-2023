#!/usr/bin/env python3
from gradelib import *

r = Runner(save("xv6.out"))

@test(1, "linked list regression")
def list_test():
    r.run_qemu(shell_script(['linked_list_test']))
    r.match('^PASSED small_push$', '^PASSED empty_pop$',
            '^PASSED many_pushes$', '^PASSED push_and_pop$',
            '^ALL TESTS PASSED$', no=['panic:', 'unexpected value', 'push failed'])

@test(1, "kernel regression")
def kernel_test():
    r.run_qemu(shell_script(['usertests -q']), timeout=300)
    r.match('^ALL TESTS PASSED$')

run_tests()
